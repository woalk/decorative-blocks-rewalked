{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/bigenergy/Decorative-Blocks-Reborn",
    "issues": "https://github.com/bigenergy/Decorative-Blocks-Reborn/issues"
  },
  "license": "${mod_license}",
  "icon" : "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "lilypuree.decorative_blocks.DecorativeBlocks"
    ],
    "client": [
      "lilypuree.decorative_blocks.ClientInitializer"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_fabric_version_range}",
    "java": ">=25"
  }
}
